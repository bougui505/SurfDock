Bootstrap: docker
From: nvidia/cuda:12.1.1-devel-ubuntu22.04

%labels
    Maintainer SurfDock Team
    Version 1.0
    Description Apptainer image for SurfDock virtual screening

%environment
    export LC_ALL=C
    export PATH=/opt/micromamba/envs/SurfDock/bin:/opt/micromamba/bin:$PATH
    export CONDA_PREFIX=/opt/micromamba/envs/SurfDock
    
    # SurfDock specific
    export SURFDOCK_ROOT=/opt/SurfDock
    export PYTHONPATH=$SURFDOCK_ROOT:$PYTHONPATH
    export MSMS_BIN=$SURFDOCK_ROOT/comp_surface/tools/APBS-3.4.1.Linux/bin/msms
    export PDB2PQR_BIN=$SURFDOCK_ROOT/comp_surface/tools/pdb2pqr-linux-bin64-2.1.1/pdb2pqr
    export APBS_BIN=$SURFDOCK_ROOT/comp_surface/tools/APBS-3.4.1.Linux/bin/apbs
    export MULTIVALUE_BIN=$SURFDOCK_ROOT/comp_surface/tools/APBS-3.4.1.Linux/share/apbs/tools/bin/multivalue
    export BABEL_LIBDIR=/opt/micromamba/envs/SurfDock/lib/openbabel/3.1.0

    # ESM and Torch weights
    export TORCH_HOME=/opt/torch_cache
    export ESM_MODEL_CACHE=/opt/torch_cache/hub/checkpoints

%files
    . /opt/SurfDock
    build_cache/torch /opt/torch_cache
    build_cache/pymesh2-0.3.1-cp310-cp310-linux_x86_64.whl /opt/pymesh2-0.3.1-cp310-cp310-linux_x86_64.whl

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        wget \
        git \
        bzip2 \
        ca-certificates \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        build-essential \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # Install Micromamba
    mkdir -p /opt/micromamba
    wget -qO- https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xj -C /opt/micromamba bin/micromamba
    export PATH=/opt/micromamba/bin:$PATH
    export MAMBA_ROOT_PREFIX=/opt/micromamba

    # Create Environment
    micromamba create -y -n SurfDock python=3.10 -c conda-forge

    # Install main dependencies (following README.md recommendations)
    micromamba install -y -n SurfDock -c pytorch -c nvidia -c pyg -c conda-forge -c defaults \
        pytorch==2.2.2 \
        pytorch-cuda=12.1 \
        numpy==1.24.4 \
        scipy==1.8.1 \
        pandas==2.1.2 \
        openff-toolkit==0.15.2 \
        openmm==8.1.1 \
        openmmforcefields==0.12.0 \
        pdbfixer==1.9 \
        babel==2.13.1 \
        biopandas==0.4.1 \
        openbabel==3.1.1 \
        plyfile==1.0.1 \
        prody==2.4.0 \
        torch-ema==0.3 \
        torchmetrics==1.2.1 \
        loguru \
        pyg

    # Install PyG extras
    micromamba run -n SurfDock pip install pyg_lib torch_scatter torch_sparse torch_cluster torch_spline_conv -f https://data.pyg.org/whl/torch-2.2.0+cu121.html

    # Install pip packages
    micromamba run -n SurfDock pip install -U --no-cache-dir \
        spyrmsd \
        scikit-learn==1.3.2 \
        accelerate==0.15.0 \
        biopython==1.79 \
        e3nn==0.5.1 \
        huggingface-hub==0.17.3 \
        mdanalysis==2.4.0 \
        posebusters==0.2.7 \
        rdkit==2023.3.1 \
        tokenizers==0.13.3 \
        transformers==4.29.2 \
        wandb==0.16.1 \
        dimorphite_dl \
        prefetch_generator

    # Install PyMesh from local wheel
    micromamba run -n SurfDock pip install /opt/pymesh2-0.3.1-cp310-cp310-linux_x86_64.whl
    rm /opt/pymesh2-0.3.1-cp310-cp310-linux_x86_64.whl

    # ESM (As mentioned in README)
    cd /opt
    git clone https://github.com/facebookresearch/esm
    cd esm
    micromamba run -n SurfDock pip install -e .

    # Pre-download ESM weights for portability
    # ESM and Torch weights are already in /opt/torch_cache via %files
    # We just need to ensure permissions are correct
    chmod -R a+rX /opt/torch_cache

    # Additional conda packages for screening
    # 'reduce' is already provided by ambertools, so we only need openbabel
    echo "Installing additional tools..."
    micromamba install -y -n SurfDock -c conda-forge openbabel

    # Finalize SurfDock
    cd /opt/SurfDock
    
    # Extract APBS/PDB2PQR
    echo "Extracting bioinformatics tools..."
    df -h /
    cd comp_surface/tools
    if [ ! -f "APBS_PDB2PQR.tar.gz" ]; then
        echo "ERROR: APBS_PDB2PQR.tar.gz not found in /opt/SurfDock/comp_surface/tools"
        ls -R /opt/SurfDock/comp_surface/tools
        exit 1
    fi
    tar -zxf APBS_PDB2PQR.tar.gz --strip-components=1
    rm APBS_PDB2PQR.tar.gz
    echo "Extraction complete."
    df -h /
    
    # Fix PyMesh libstdc++ issue (Tip 1 in README)
    echo "Patching PyMesh..."
    PYMESH_DIR=$(micromamba run -n SurfDock python -c "import pymesh; import os; print(os.path.dirname(pymesh.__file__))" 2>/dev/null || echo "")
    if [ -n "$PYMESH_DIR" ] && [ -f "$PYMESH_DIR/lib/libstdc++.so.6" ]; then
        mv "$PYMESH_DIR/lib/libstdc++.so.6" "$PYMESH_DIR/lib/libstdc++.so.6.bak"
        echo "PyMesh patched successfully."
    else
        echo "PyMesh patch skipped (already patched or not found)."
    fi

    # Update global_vars.py to use absolute paths in /opt/SurfDock
    echo "Updating configuration paths..."
    GLOBAL_VARS="/opt/SurfDock/comp_surface/prepare_target/default_config/global_vars.py"
    if [ -f "$GLOBAL_VARS" ]; then
        sed -i 's|~/SurfDock|/opt/SurfDock|g' "$GLOBAL_VARS"
        echo "Configuration updated."
    else
        echo "WARNING: global_vars.py not found at $GLOBAL_VARS"
    fi

%runscript
    # Default to help message or bash
    if [ $# -eq 0 ]; then
        echo "SurfDock Apptainer Container"
        echo "----------------------------"
        echo "Environment: CUDA 12.1, SurfDock dependencies, and ESM weights pre-loaded."
        echo ""
        echo "Usage: apptainer exec --nv surfdock.sif <command>"
        echo ""
        echo "1. Custom Screening (PDB + SMI + Pocket Coordinates):"
        echo "   apptainer exec --nv surfdock.sif bash /opt/SurfDock/bash_scripts/test_scripts/screen_custom.sh \\"
        echo "       --protein protein.pdb \\"
        echo "       --ligands ligands.smi \\"
        echo "       --pocket_center \"x,y,z\" \\"
        echo "       --radius 8.0 \\"
        echo "       --out_dir ./results"
        echo ""
        echo "2. Standard Screening Pipeline:"
        echo "   apptainer exec --nv surfdock.sif bash /opt/SurfDock/bash_scripts/test_scripts/screen_pipeline_container.sh"
    else
        exec "$@"
    fi
